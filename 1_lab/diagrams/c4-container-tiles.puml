@startuml c4-container-tiles
!include <C4/C4_Container>

title C4, уровень 2: картографический сервис

Person(users, "Клиент, диспетчер, водитель", "Карта на страницах отслеживания, ввод адреса")

Container(public_gw, "Public Gateway", "Kong без БД", "Кэширует тайлы текущей версии")
Container(route_api, "Route API", "REST API", "Оценка расстояния")
Container(route_planner, "Route Planner", "воркер Kafka", "Построение маршрута")

Boundary(map_group, "Tile Service", "типовой поддомен, данные только для чтения") {
  Container(map_api, "Tile API", "REST API", "Тайлы, геокодинг, путь, матрица расстояний")
  ContainerDb(map_tiles, "Тайлы и граф дорог", "MBTiles, граф OSRM", "Файлы на томах подов, версия набора данных")
  ContainerDb(map_geo, "Индекс геокодинга", "PostgreSQL + PostGIS", "Адреса и объекты")
  Container(map_import, "Импорт карты", "пакетная задача, раз в неделю", "Собирает новую версию из выгрузки OpenStreetMap, переключает версию")
}

Rel(users, public_gw, "Тайлы, подсказки адреса", "HTTPS")
Rel(public_gw, map_api, "GET /tiles, /geocode", "REST")
Rel(route_api, map_api, "POST /matrix", "REST")
Rel(route_planner, map_api, "/geocode, /directions, /matrix", "REST")
Rel(map_api, map_tiles, "Читает")
Rel(map_api, map_geo, "Читает", "SQL")
Rel(map_import, map_tiles, "Пишет новую версию")
Rel(map_import, map_geo, "Пишет новую версию", "SQL")

SHOW_LEGEND()
@enduml
