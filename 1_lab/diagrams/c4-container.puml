@startuml c4-container
!include <C4/C4_Container>

title C4, уровень 2: контейнеры, обзор

' Обзорная схема: только контейнеры и направления вызовов.
' Хранилища, топики и детали раскрыты во фрагментах c4-container-*.puml

Person(customer, "Клиент", "Грузоотправитель или грузополучатель")
Person(dispatcher, "Диспетчер", "Автопарк, рейсы, тарифы")
Person(driver, "Водитель", "Мобильное приложение")
System_Ext(telematics, "Телематика", "GPS-трекеры")
System_Ext(external, "Внешние системы", "Identity Provider, провайдеры связи")

System_Boundary(platform, "Логистическая платформа") {
  Container(public_gw, "Public Gateway", "Kong без БД", "API клиентов и диспетчеров")
  Container(ingest_gw, "Ingest Gateway", "Kong без БД", "Только телеметрия")

  Container(shipment_svc, "Shipment", "REST", "Заказы и грузы")
  Container(pricing_svc, "Pricing", "REST", "Стоимость, тарифы")
  Container(route_api, "Route API", "REST", "Оценка, просмотр, перепланирование")
  Container(route_planner, "Route Planner", "воркер Kafka", "Построение маршрута, назначение рейса")
  Container(fleet_svc, "Fleet", "REST", "Транспорт, водители, бронь")
  Container(map_svc, "Map", "REST", "Тайлы, геокодинг, расстояния")
  Container(tracking_svc, "Tracking", "Ingest, Writer, Query", "Телеметрия и вехи")
  Container(notification_svc, "Notification", "воркер Kafka, REST", "Уведомления")

  ContainerQueue(kafka, "Kafka", "Apache Kafka", "Доменные события")
}

Rel(customer, public_gw, "HTTPS")
Rel(dispatcher, public_gw, "HTTPS")
Rel(driver, ingest_gw, "HTTPS")
Rel(telematics, ingest_gw, "HTTPS")

Rel(public_gw, shipment_svc, "REST")
Rel(public_gw, pricing_svc, "REST")
Rel(public_gw, route_api, "REST")
Rel(public_gw, fleet_svc, "REST")
Rel(public_gw, map_svc, "Тайлы, геокодинг")
Rel(public_gw, tracking_svc, "Позиция")
Rel(public_gw, notification_svc, "REST")
Rel(ingest_gw, tracking_svc, "Телеметрия")

Rel(shipment_svc, pricing_svc, "Котировка")
Rel(pricing_svc, route_api, "Расстояние")
Rel(route_api, map_svc, "Матрица")
Rel(route_planner, map_svc, "Путь")
Rel(route_planner, fleet_svc, "Бронь")
Rel(notification_svc, fleet_svc, "Контакт")
Rel(notification_svc, external, "HTTPS")

Rel(shipment_svc, kafka, "события")
Rel(route_api, kafka, "запросы на перепланирование")
Rel(route_planner, kafka, "события")
Rel(fleet_svc, kafka, "события")
Rel(tracking_svc, kafka, "события")
Rel(kafka, notification_svc, "события")

SHOW_LEGEND()
@enduml
