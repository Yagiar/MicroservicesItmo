@startuml c4-context
!include <C4/C4_Context>

title C4, уровень 1: системный контекст логистической платформы

Person(customer, "Клиент", "Грузоотправитель или грузополучатель")
Person(dispatcher, "Диспетчер", "Управляет автопарком, рейсами и тарифами")
Person(driver, "Водитель", "Выполняет рейсы, работает в мобильном приложении")

System(platform, "Логистическая платформа", "Заказы перевозки, расчёт стоимости, маршруты, автопарк, отслеживание, уведомления")

System_Ext(telematics, "Телематика", "GPS-трекеры транспорта")
System_Ext(idp, "Identity Provider", "Аутентификация, профили и контакты клиентов")
System_Ext(maps, "Картографический сервис", "Геокодинг и матрица расстояний")
System_Ext(comms, "Провайдеры связи", "SMS, e-mail, push")

Rel(customer, platform, "Рассчитывает стоимость, создаёт заказы, отслеживает доставку", "HTTPS")
Rel(dispatcher, platform, "Управляет автопарком, рейсами и тарифами", "HTTPS")
Rel(driver, platform, "Передаёт геопозицию и вехи доставки", "HTTPS")
Rel(telematics, platform, "Передаёт геопозицию транспорта", "HTTPS")

Rel(platform, idp, "Проверяет токены, получает контакты клиентов", "HTTPS")
Rel(platform, maps, "Запрашивает координаты и расстояния", "HTTPS")
Rel(platform, comms, "Отправляет сообщения", "HTTPS")

SHOW_LEGEND()
@enduml
